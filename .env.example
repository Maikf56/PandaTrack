# PandaTrack 配置项清单（仅键名与示例值，真实值经环境注入，绝不入库 —— 00 §10 / 02 §4.3）

# ---- 运行环境 ----
APP_ENV=acceptance            # development | acceptance | production
LOG_LEVEL=INFO

# ---- 数据库（A 采集事实 / B 客户账务，物理分库）----
DATABASE_A_URL=postgresql://pandatrack:CHANGE_ME@127.0.0.1:5432/pandatrack_a
DATABASE_B_URL=postgresql://pandatrack:CHANGE_ME@127.0.0.1:5432/pandatrack_b

# ---- Redis（仅 broker，可由 DB 重建）----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- BFF ----
BFF_HOST=127.0.0.1
BFF_PORT=8000
SESSION_COOKIE_NAME=pdtrk_session
SESSION_TTL_HOURS=24

# ---- 采集（模块 02/07）----
USPS_MAX_ENVIRONMENTS=        # 留空则按内存自动推算 max(2,(available_mb-900)//550)
CLAWBROWSER_CDP_URL=          # ClawBrowser CDP 端点（秘密，见 01 注入）
PROXY_ENDPOINT=               # udealproxy 住宅代理端点（秘密）
PROXY_USERNAME=               # 代理凭据（秘密）
PROXY_PASSWORD=               # 代理凭据（秘密）

# ---- Provider 开关（fail-closed：未通过 Linux 真实验收前必须为 false）----
USPS_WEB_PROVIDER_ENABLED=false

# ---- 计费（模块 06）----
BILLING_FREE_WINDOW_DAYS=30   # UTC 滚动 30×24h 同客户同单号免扣
SUBMIT_SINGLE_LIMIT=35        # 单次输入上限（非 QPS）
SUBMIT_MAX_TOTAL=1000000      # 批量受理上限

# ---- 管理（模块 03/09）----
ADMIN_INTERNAL_CIDR=10.0.0.0/8  # admin 域仅内网

# ---- 测试黑名单（P9：命中单号不入队采集，事件标记 processed）----
PT_ENQUEUE_SKIP_NUMBERS=      # 逗号分隔单号，防测试触发真实采集

# ---- 轨迹翻译（04 §6 增值项；Google Cloud Translation v2）----
PT_TRANSLATE_API_KEY=         # 留空则轨迹翻译优雅降级为原文，不影响查询主链路
